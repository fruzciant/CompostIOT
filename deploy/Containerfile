# Imagen multi-etapa CompostIOT (Backend Go + SQLite + Frontend Web compilado)
# Compatible con Podman y Docker: podman build -f deploy/Containerfile -t compostiot:latest .

FROM node:22-alpine AS web-builder
WORKDIR /src/web
RUN corepack enable
COPY web/package.json web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ ./
RUN pnpm build

FROM golang:1.26-alpine AS go-builder
WORKDIR /src/backend
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/compostiot-server ./cmd/server

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
ENV TZ=America/Bogota
WORKDIR /app
COPY --from=go-builder /out/compostiot-server /app/compostiot-server
COPY --from=web-builder /src/web/dist /app/web-dist
RUN mkdir -p /data

ENV COMPOST_PORT=8080
ENV COMPOST_DB_PATH=/data/compostiot.db
ENV COMPOST_WEB_DIR=/app/web-dist
ENV COMPOST_SERVER_NAME="CompostIOT Nube SENA"

EXPOSE 8080
VOLUME ["/data"]

ENTRYPOINT ["/app/compostiot-server"]
