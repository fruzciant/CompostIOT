{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "CompostIOT",
  "outputfilename": "CompostIOT",
  "frontend:dir": "../web",
  "frontend:install": "pnpm install",
  "frontend:build": "pnpm build && node -e \"const fs=require('fs'); fs.rmSync('../desktop/frontend/dist',{recursive:true,force:true}); fs.cpSync('dist','../desktop/frontend/dist',{recursive:true});\"",
  "frontend:dev:watcher": "pnpm dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "CompostIOT SENA"
  }
}
